# Copy to .env and change the password. .env is git-ignored.
# Local development only; never reuse these values anywhere real.
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me-local-only
AEGIS_LOG_LEVEL=info
# Host port for PostgreSQL (change if a local PostgreSQL already uses 5432)
POSTGRES_HOST_PORT=5432

# For running the API or integration tests from the host (outside Docker):
# AEGIS_DATABASE_URL=postgres://aegis:change-me-local-only@127.0.0.1:${POSTGRES_HOST_PORT}/aegis?sslmode=disable
# AEGIS_TEST_DATABASE_URL=postgres://aegis:change-me-local-only@127.0.0.1:${POSTGRES_HOST_PORT}/aegis_test?sslmode=disable

# Optional Module G model (see docs/modules/investigator.md). "none" = deterministic briefs only.
AEGIS_AI_PROVIDER=none
# AEGIS_AI_MODEL=qwen2.5:3b
