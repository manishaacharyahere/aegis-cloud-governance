# Copy to .env and change the password. .env is git-ignored.
# Local development only; never reuse these values anywhere real.
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me-local-only
AEGIS_LOG_LEVEL=info

# For running the API or integration tests from the host (outside Docker):
# AEGIS_DATABASE_URL=postgres://aegis:change-me-local-only@127.0.0.1:5432/aegis?sslmode=disable
# AEGIS_TEST_DATABASE_URL=postgres://aegis:change-me-local-only@127.0.0.1:5432/aegis_test?sslmode=disable
