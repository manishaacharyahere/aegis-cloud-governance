# Copy to .env and change the password. .env is git-ignored.
# Local development only; never reuse these values anywhere real.
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me-local-only
# Token for the OPA API (OPA only allows policy evaluation with it). Generate one:
#   python -c "import secrets; print(secrets.token_hex(24))"
AEGIS_OPA_TOKEN=change-me-local-only-opa-token
# Password of the aegis_api NATS user (anonymous NATS access is off)
AEGIS_NATS_PASSWORD=change-me-local-only-nats-password
AEGIS_LOG_LEVEL=info
# Host port for PostgreSQL (change if a local PostgreSQL already uses 5432)
POSTGRES_HOST_PORT=5432

# For running the API or integration tests from the host (outside Docker):
# AEGIS_DATABASE_URL=postgres://aegis:change-me-local-only@127.0.0.1:${POSTGRES_HOST_PORT}/aegis?sslmode=disable
# AEGIS_TEST_DATABASE_URL=postgres://aegis:change-me-local-only@127.0.0.1:${POSTGRES_HOST_PORT}/aegis_test?sslmode=disable

# Optional Module G model (see docs/modules/investigator.md). "none" = deterministic briefs only.
AEGIS_AI_PROVIDER=none
# AEGIS_AI_MODEL=qwen2.5:3b

# Observability profile (docker compose --profile observability). Grafana login: admin / this password.
GRAFANA_ADMIN_PASSWORD=change-me-local-only
# Export traces to Jaeger when the observability profile is running:
# AEGIS_OTLP_ENDPOINT=http://jaeger:4318

# Authentication. dev-headers trusts X-Aegis-Actor (development only, refused in production).
# With the auth profile (Dex): AEGIS_AUTH_MODE=oidc and AEGIS_BOOTSTRAP_ADMINS=admin@aegis.local
AEGIS_AUTH_MODE=dev-headers
# AEGIS_BOOTSTRAP_ADMINS=admin@aegis.local
